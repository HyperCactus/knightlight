{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knightlight",
  "version": "0.1.0",
  "identifier": "app.knightlight.desktop",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Your personal offline chess coach",
    "longDescription": "Practice your weaknesses, review your games, and play a human-like adaptive opponent with local spoken coaching.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/": "resources/"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libasound2t64",
          "libgomp1",
          "libstdc++6",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGNzA5QjU4ODc5QUE4NDMKUldSRHFKcUhXSnR3ditZMjdJRE15cnRsS1kzdU1aVUdxTHNtOVNONG5QTDFQbmVGb2xzRy9pNVoK",
      "endpoints": [
        "https://github.com/HyperCactus/knightlight/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
